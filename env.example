# Copy to `.env` in this folder and fill in. Keep `.env` out of version control.

# The server's SOAP console. 127.0.0.1 works when the port is mapped to the
# host only.
DM_SOAP_URL=http://127.0.0.1:7878/

# A dedicated game account at level 3. Name and password are 16 characters
# at most.
DM_SOAP_USER=OVERSEER
DM_SOAP_PASS=change-me

# Where compose.yaml lives. Used to reach the database container.
DM_COMPOSE_DIR=~/cmangos-deploy

# The model that writes quests. Get a key from the Claude Console.
ANTHROPIC_API_KEY=sk-ant-...
DM_MODEL=claude-sonnet-5-5

# Folder of the server's extracted .dbc files, used to tell friend from foe.
# Only needed if the server is laid out differently; the default is
# <DM_COMPOSE_DIR>/storage/classic/mangosd/extracted-data/dbc
#DM_DBC_DIR=

# ---- The story loop (dm.py) ----

# Minutes to wait after a bounty is finished before proposing the next one.
DM_COOLDOWN_MINUTES=20

# An offered bounty that nobody accepts is dropped after this many hours.
DM_STALE_HOURS=24

# Ceiling on model calls per hour.
DM_MAX_PROPOSALS_HOUR=6

# Gear rewards. At most one bounty in DM_GEAR_EVERY pays gear; a rare prize
# needs a significant bounty (a mark, a named creature, an arc's finale) and
# DM_PRIZE_LEVEL_SPAN levels since the last one. No rare gear exists below
# power level 15, so prizes first appear at level 15 - DM_PRIZE_REACH.
DM_GEAR_EVERY=2
DM_PRIZE_LEVEL_SPAN=4
DM_PRIZE_REACH=5

# Proposal types that go live without your review, comma separated.
# Types: bounty, arc, chapter, letter. Set all four for a fully automatic DM.
DM_AUTO_APPROVE=letter

# Plan types you would rather not read, because you play on this server:
# arc, chapter. They are approved without review, and their text is printed
# only with --reveal.
DM_SEALED=

# Ticks a character must spend in one zone before a chapter is written for it.
DM_SETTLE_TICKS=3

# Model for the rare planning calls (chapters). Empty: the same as DM_MODEL.
DM_PLAN_MODEL=

# The only characters the DM may notice, comma separated. Leave empty and it
# notices everyone who is online and not ignored below.
#
# Set this if the server runs playerbots. A bot realm holds a thousand
# characters or more, far too many to list in DM_IGNORE_CHARACTERS, and
# without this the DM would spend its model calls writing private story arcs
# for bots. Names, not guids: a character deleted and made again keeps its
# name but takes a new guid.
DM_CHARACTERS=

# Characters the DM should not track, comma separated (alts, test characters).
# Applied after DM_CHARACTERS, so a name here is ignored either way.
DM_IGNORE_CHARACTERS=

# Optional: a character the DM account owns. Mail players send to it is read
# as letters to the Overseer and becomes part of the story.
DM_MAIL_CHARACTER=

# ---- The kill switch ----

# Set to 1 to stop everything that reaches the game: no tick, no model call,
# no quest written, no console command. Reading still works. `python3 dm.py
# pause "why"` does the same through a flag file and is easier to undo.
#DM_PAUSE=0

# Where that flag file lives. The default is `paused` beside the scripts.
#DM_PAUSE_FILE=

# ---- Narrow database users ----

# The DM should not speak to the game as root. `python3 db_users.py --create
# --write-env` makes two users and fills these in: a reader that cannot write
# and a writer that can only touch the tables a bounty lives in. Unset, both
# fall back to root.
#DM_DB_QUERY_COMMAND=
#DM_DB_COMMAND=

# The compose service running the database, if it is not called "database".
#DM_DB_SERVICE=database
